@page "/Authors"
@inject HttpClient Http
@using ClassLibrary.Response

<h3>Authors</h3>
<AuthorizeView Roles="Admin,SuperUser">
    <Authorized>
        @if (true)
        {
            <a href="/authors/create" class="btn btn-sm btn-primary">Create</a>
        }
    </Authorized>
</AuthorizeView>
@if (Authors == null)
{

}
else
{
    <div class="container">
        <table class="table">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Birthyear</th>
                    <th>Deathyear</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var author in Authors)
                {
                    <tr>
                        <td>@author.FirstName</td>
                        <td>@author.LastName</td>
                        <td>@author.Birthyear</td>
                        <td>@author.Deathyear</td>
                        <td>
                            <a href="/authors/details/@author.Id" class="btn btn-sm btn-success">Details</a>
                            <AuthorizeView Roles="Admin,SuperUser">
                                <Authorized>
                                    <a href="/authors/edit/@author.Id" class="btn btn-sm btn-info">Edit</a>
                                    <a href="/authors/delete/@author.Id" class="btn btn-sm btn-danger">Delete</a>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


@code {
    private List<AuthorResponse>? Authors;

    protected override async Task OnInitializedAsync()
    {
        Authors = await Http.GetFromJsonAsync<List<AuthorResponse>>("api/authors");
    }
}
