@page "/books/create"
@inject HttpClient http
@inject NavigationManager NavMan
@using ClassLibrary
@using ClassLibrary.Request
@using ClassLibrary.Response
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin, SuperUser")]

<h3>Create author</h3>

<div class="container">
    <EditForm Model="@Book" OnValidSubmit="@AddBook">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row">
            <div class="col col-md-3">
                <div class="form-group">
                    <label for="Title" class="form-label">Title</label><br />
                    <InputText id="Title" class="form-control" @bind-Value="Book.Title" />
                    <ValidationMessage For="@(() => Book.Title)" />
                </div>
                <div class="form-group">
                    <label for="Edition" class="form-label">Edition</label><br />
                    <InputNumber id="Edition" class="form-control" @bind-Value="Book.Edition" />
                    <ValidationMessage For="@(() => Book.Edition)" />
                </div>
                <div class="form-group">
                    <label for="PublishYear" class="form-label">Published in</label><br />
                    <InputNumber id="PublishYear" class="form-control" @bind-Value="Book.PublishYear" />
                    <ValidationMessage For="@(() => Book.PublishYear)" />
                </div>
            </div>
            <div class="col col-md-3">
                <div class="form-group">
                    <label for="authorId" class="form-label">Author</label><br />
                    <InputSelect id="authorId" class="form-select" @bind-Value="Book.AId">
                        @foreach (var _author in Authors)
                        {
                            <option value="@_author.Value">@_author.Text</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-group">
                    <label for="Title" class="form-label">In Stock</label><br />
                    <InputNumber id="Stock" class="form-control" @bind-Value="Book.Stock" />
                    <ValidationMessage For="@(() => Book.Stock)" />
                </div>                
                <div class="form-group">
                    <label for="Pagecount" class="form-label">Page count</label><br />
                    <InputNumber id="Pagecount" class="form-control" @bind-Value="Book.Pagecount" />
                    <ValidationMessage For="@(() => Book.Pagecount)" />
                </div>
            </div>
        </div>
        <br />
        <div class="form-group">
            <label for="Description" class="form-label">Description</label><br />
            <InputTextArea id="Description" height="200px" class="form-control" @bind-Value="Book.Description" />
            <ValidationMessage For="@(() => Book.Description)" />
        </div>
        <br />
        <button type="submit" class="btn btn-primary">Create</button>
        <a href="/books" class="btn btn-secondary">Cancel</a>

        publisher
    </EditForm>
    
</div>



@code {
    BookRequest Book { get; set; } = new();
    List<SelectListItem> Authors { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var response = await http.GetAsync("api/authors");
        if (response.IsSuccessStatusCode)
        {
            var authors = await response.Content.ReadFromJsonAsync<List<AuthorResponse>>();

            foreach (var author in authors)
            {
                Authors.Add(new() { Value = author.Id, Text = author.FirstName + " " + author.LastName });
            }
        }
    }

    
    
    async Task AddBook()
    {
        var response = await http.PostAsJsonAsync("api/Books", Book);
        if (response.IsSuccessStatusCode)
        {
            NavMan.NavigateTo("/Books");
        }
        else
        {
            Console.WriteLine($"Error: {response.ReasonPhrase}");
        }
    }
}
