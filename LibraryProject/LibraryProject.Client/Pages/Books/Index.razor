@page "/Books"
@inject HttpClient Http
@using ClassLibrary.Response

<h3>Books</h3>
<AuthorizeView Roles="Admin,SuperUser">
    <Authorized>
        <a href="/books/create" class="btn btn-sm btn-primary">Create</a>
    </Authorized>
</AuthorizeView>
@if (Books == null)
{

}
else
{
    <div class="container">
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Books)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author.FirstName @book.Author.LastName</td>
                        <td>@book.Stock</td>
                        <td>
                            <a href="/books/details/@book.Id" class="btn btn-sm btn-success">Details</a>
                            <AuthorizeView Roles="Admin,SuperUser">
                                <Authorized>
                                    <a href="/books/edit/@book.Id" class="btn btn-sm btn-info">Edit</a>
                                    <a href="/books/delete/@book.Id" class="btn btn-sm btn-danger">Delete</a>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


@code {
    private List<BookResponse>? Books;

    protected override async Task OnInitializedAsync()
    {
        Books = await Http.GetFromJsonAsync<List<BookResponse>>("api/books");
    }
}
