@code
{
    private List<BookResponse> Books { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        //ThreeRandomBooks();
    }

    private async void ThreeRandomBooks()
    {
        Random rand = new();
        for (int i = 0; i < 3; i++)
        {
            while (true)
            {
                var number = rand.Next();
                var book = await Http.GetFromJsonAsync<BookResponse>($"api/books/{number}");
                if (book != null)
                {
                    Books.Add(book);
                    break;
                }
            }
        }
    }
}
